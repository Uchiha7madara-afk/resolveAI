# Supabase (required) — from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# LLM bill parsing (required for analysis — pick ONE provider).
# Anthropic is recommended: it handles both PDF and image bills.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-4-5)
# ANTHROPIC_MODEL=

# OpenAI alternative (images only — PDF bills require Anthropic)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
